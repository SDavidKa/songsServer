# External host used in links generated in emails (password recovery, etc.)
HOST=https://songs.example.com

# Connection to an existing PostgreSQL instance (not managed by docker-compose).
# Use host.docker.internal if Postgres runs on the same host machine, outside Docker.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
# POSTGRES_DB is the actual database; POSTGRES_SCHEMA is the
# per-project schema inside it that unqualified table/function names resolve against.
# Leave POSTGRES_SCHEMA unset to use the role's default schema/search_path.
POSTGRES_DB=songsserver_db
POSTGRES_SCHEMA=
POSTGRES_USER=songsserver_user
POSTGRES_PASSWORD=

# JWT signing secret
JWT_SECRET=

# S3-compatible storage for audio files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
